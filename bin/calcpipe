#!/usr/bin/env perl
use warnings;
use strict;

use Scalar::Util qw(looks_like_number);

use FindBin;
use lib "${FindBin::Bin}/../lib";

use My::Calc::Functions qw(:all);
use My::Calc::Calc qw(eval_calc_tag $RX_CALC_TAG);

local $/ = undef;
while (<>) {
    s{$RX_CALC_TAG}{eval_calc_tag($&, %+)}ge;
    print;
}
